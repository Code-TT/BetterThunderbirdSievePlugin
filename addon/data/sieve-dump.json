{
  "scripts": {
    "sogo": "require [\"fileinto\"];\nif allof (address :contains \"from\" \"aliexpress.com\") {\n    fileinto \"AliExpress\";\n}\nif allof (address :contains \"from\" \"dhgate.com\") {\n    fileinto \"DHgate\";\n}\nif anyof (address :contains \"from\" \"facebook.com\", address :contains \"from\" \"facebookmail.com\") {\n    fileinto \"Facebook\";\n}\nif allof (address :contains \"from\" \"banggood.com\") {\n    fileinto \"Banggood.com\";\n}\nif anyof (address :contains \"from\" \"temuemail.com\", address :contains \"from\" \"temu.com\") {\n    fileinto \"Temu\";\n}\nif anyof (address :contains \"from\" \"xing.com\") {\n    fileinto \"Xing\";\n}\nif allof (address :contains \"from\" \"info@m.bodylab24.de\") {\n    fileinto \"Werbung\";\n}\nif allof (address :contains \"from\" \"news.outlet46.de\") {\n    fileinto \"Werbung\";\n}\nif allof (address :contains \"from\" \"comms.mandmdirect.com\") {\n    fileinto \"Werbung\";\n}\nif allof (address :contains \"from\" \"mail.otto.de\") {\n    fileinto \"Werbung\";\n}\nif allof (address :contains \"from\" \"nl.urlaubsguru.de\") {\n    fileinto \"Werbung\";\n}\nif allof (address :contains \"from\" \"email.eyesandmore.com\") {\n    fileinto \"Werbung\";\n}\nif allof (address :contains \"from\" \"newsletter@apolux.de\") {\n    fileinto \"Werbung\";\n}\nif allof (address :contains \"from\" \"info.shop-apotheke.com\") {\n    fileinto \"Werbung\";\n}\nif allof (address :contains \"from\" \"info@guenther.de\") {\n    fileinto \"Werbung\";\n}\nif allof (address :contains \"from\" \"anja.weber@pearl.de\") {\n    fileinto \"Werbung\";\n}\nif allof (address :contains \"from\" \"info@mail.lidl.de\") {\n    fileinto \"Werbung\";\n}\nif allof (address :contains \"from\" \"info@mc.flyeralarm.com\") {\n    fileinto \"Werbung\";\n}\nif allof (address :contains \"from\" \"newsletter@angebote.aldi-sued.de\") {\n    fileinto \"Werbung\";\n}\nif allof (address :contains \"from\" \"kontakt@quovadis.net\") {\n    fileinto \"Werbung\";\n}\nif allof (address :contains \"from\" \"news.docmorris.de\") {\n    fileinto \"Werbung\";\n}\n"
  },
