{
  "manifest_version": 2,
  "name": "Sieve Filter View",
  "version": "0.1.0",
  "description": "PoC: zeigt Server-Sieve-Regeln read-only in der Thunderbird/Betterbird-Filterliste an.",
  "browser_specific_settings": {
    "gecko": {
      "id": "sieve-filter-view@trella.de",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": ["background.js"]
  },
  "permissions": ["storage"],
  "experiment_apis": {
    "sieveView": {
      "schema": "experiment/schema.json",
      "parent": {
        "scopes": [],
        "script": "experiment/api.js"
      }
    }
  }
}
